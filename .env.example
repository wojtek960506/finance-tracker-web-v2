# Base URL of the backend, without the /api suffix.
# The frontend will call `${VITE_API_BASE_URL}/api/...`.
#
# Local development:
VITE_API_BASE_URL=http://localhost:5000
#
# Same-origin deployment behind a reverse proxy:
# VITE_API_BASE_URL=/
#
# Separate hosted backend:
# VITE_API_BASE_URL=https://api.example.com

# Relative path to backend openapi.json for local type generation (leave empty or omit in production)
VITE_OPENAPI_SPEC_PATH=../finance-tracker-api/openapi.json

